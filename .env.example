# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=djs_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=distributed_job_scheduler
DATABASE_URL=postgresql+asyncpg://djs_user:CHANGE_ME@localhost:5432/distributed_job_scheduler
DATABASE_URL_SYNC=postgresql://djs_user:CHANGE_ME@localhost:5432/distributed_job_scheduler

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Authentication ──────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_QUEUES=default
WORKER_POLL_INTERVAL=1.0
WORKER_HEARTBEAT_INTERVAL=30

# ─── Application ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
